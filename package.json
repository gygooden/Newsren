{
  "name": "newsren",
  "version": "0.1.0",
  "private": true,
  "description": "My Newsren: a grounded personal news research agent with a Ground Level lens. Course proof of concept.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run briefings && next build && node -e \"require('fs').writeFileSync('out/.nojekyll','')\"",
    "ingest": "tsx scripts/ingest.ts && tsx scripts/build-briefings.ts",
    "briefings": "tsx scripts/build-briefings.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "npm run build:e2e && playwright test",
    "contrast": "tsx scripts/check-contrast.ts",
    "eval": "tsx scripts/eval.ts",
    "serve": "tsx scripts/serve.ts",
    "build:e2e": "NEXT_PUBLIC_BASE_PATH=/newsren NEXT_PUBLIC_AGENT_URL=http://localhost:8787 npm run build"
  },
  "dependencies": {
    "next": "15.5.27",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@axe-core/playwright": "^4.10.2",
    "@cloudflare/workers-types": "^5.20261023.1",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.1",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4",
    "wrangler": "^4.40.2"
  }
}
